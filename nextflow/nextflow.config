
params {
  use_container = false
  alpaca_container = 'docker://wlippa/alpaca:1.0'
  gurobi_license_file = ''
}

def useContainer = params.use_container in [true, 1, '1', 'true', 'TRUE', 'yes', 'YES', 'on', 'ON']
def gurobiLicenseFile = params.gurobi_license_file?.toString()?.trim()
def gurobiRunOptions = gurobiLicenseFile ? "--bind ${gurobiLicenseFile}:${gurobiLicenseFile}:ro --env GRB_LICENSE_FILE=${gurobiLicenseFile}" : ''

singularity {
  enabled = useContainer
  autoMounts = true
  runOptions = gurobiRunOptions
}

profiles {
  slurm { includeConfig 'slurm.conf' }
  local { includeConfig 'local.conf' }

}
