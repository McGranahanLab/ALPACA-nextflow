
params {
  use_container = false
  alpaca_container = 'docker://wlippa/alpaca:latest'
  gurobi_license_file = ''
}

def useContainer = params.use_container in [true, 1, '1', 'true', 'TRUE', 'yes', 'YES', 'on', 'ON']
def gurobiLicenseFile = params.gurobi_license_file?.toString()?.trim()
def gurobiLicenseDir = gurobiLicenseFile ? new File(gurobiLicenseFile).getParent() : ''
def bindDirs = []
[params.alpaca_work_dir, params.pool_dir, params.in_progress_dir, params.done_dir, params.failed_dir, params.outputs_dir, params.input_dir, params.output_dir, params.script_dir].each { p ->
  def s = p?.toString()?.trim()
  if (s) bindDirs << s
}
if (gurobiLicenseDir) bindDirs << gurobiLicenseDir
def bindOptions = bindDirs.collect { "--bind ${it}:${it}" }.unique().join(' ')
def gurobiEnvOption = gurobiLicenseFile ? "--env GRB_LICENSE_FILE=${gurobiLicenseFile}" : ''
def gurobiRunOptions = [bindOptions, gurobiEnvOption].findAll { it }.join(' ')

singularity {
  enabled = useContainer
  autoMounts = true
  runOptions = gurobiRunOptions
}

profiles {
  slurm { includeConfig 'slurm.conf' }
  local { includeConfig 'local.conf' }

}
